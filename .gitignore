# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw source photos/video — originals kept locally, NOT tracked. The committed
# slot assets are the web-optimized .jpg files produced by
# scripts/process-photos.mjs (re-run it after dropping new originals in _source/).
/public/photos/_source/

# private build transcript — kept local, never published
/yc-coding-session.md
